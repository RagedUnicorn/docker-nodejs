{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RagedUnicorn/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Automatically merge Node.js and npm apk updates: superseded pins vanish from the Alpine package index and break the image build, so merge as soon as tests pass",
      "matchDatasources": [
        "repology"
      ],
      "matchPackageNames": [
        "/^alpine_\\d+_\\d+/nodejs$/",
        "/^alpine_\\d+_\\d+/npm$/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Group the pinned Node.js and npm apk versions into one PR (separate aports, but both pins ride the same Alpine branch)",
      "matchDatasources": [
        "repology"
      ],
      "matchPackageNames": [
        "/^alpine_\\d+_\\d+/nodejs$/",
        "/^alpine_\\d+_\\d+/npm$/"
      ],
      "groupName": "nodejs",
      "groupSlug": "nodejs"
    }
  ],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "assignees": [
    "ragedunicorn"
  ]
}
